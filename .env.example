# Copy to .env (gitignored) and fill in EMPLOYEE_PASSWORD. Ask the QA manager for it - never commit it.
# Used by ./run-tests.sh. ENV, BASE_URL, BROWSER and HEADED become -Denv, -DbaseUrl, -Dbrowser and -Dheadless.
ENV="test"
BASE_URL="https://10.20.3.66/innovation-portal"
EMPLOYEE_USERNAME="ADTest\Adtest04"
EMPLOYEE_PASSWORD=""
HEADED="false"
# Project settings from docs/PROJECT_CONTEXT.md. The framework does not read these yet (tests run one at a time).
RETRY_COUNT="1"
PARALLEL="1"
LOG_LEVEL="info"
# chromium is an alias of chrome
BROWSER="chromium"

# Role accounts referenced by the test data JSON. Until separate accounts exist they use the employee account.
EVALUATOR_USERNAME="$EMPLOYEE_USERNAME"
EVALUATOR_PASSWORD="$EMPLOYEE_PASSWORD"
PROJECT_MANAGER_USERNAME="$EMPLOYEE_USERNAME"
PROJECT_MANAGER_PASSWORD="$EMPLOYEE_PASSWORD"
ADMIN_USERNAME="$EMPLOYEE_USERNAME"
ADMIN_PASSWORD="$EMPLOYEE_PASSWORD"
VERTICAL_HEAD_USERNAME="$EMPLOYEE_USERNAME"
VERTICAL_HEAD_PASSWORD="$EMPLOYEE_PASSWORD"
PRACTICE_HEAD_USERNAME="$EMPLOYEE_USERNAME"
PRACTICE_HEAD_PASSWORD="$EMPLOYEE_PASSWORD"
DEPARTMENT_HEAD_USERNAME="$EMPLOYEE_USERNAME"
DEPARTMENT_HEAD_PASSWORD="$EMPLOYEE_PASSWORD"
# Employee without evaluator rights (TC-NEW-035): Adtest15, the submitter in the idea routing data
EMPLOYEE_ONLY_USERNAME="ADTest\Adtest15"
EMPLOYEE_ONLY_PASSWORD="$EMPLOYEE_PASSWORD"

# Accounts from the idea routing data (src/test/resources/testdata/idea-routing.json).
# All test accounts share the employee password, so they reuse EMPLOYEE_PASSWORD. Login IDs follow the ADTest\<user> pattern.
# Adtest15: Employee who submits the ideas (Client: Cisco, Mastercard; Organisation: HR, IT Support)
ADTEST15_USERNAME="ADTest\Adtest15"
ADTEST15_PASSWORD="$EMPLOYEE_PASSWORD"
# Adtest09: default evaluator for Cisco (Hi-Tech); committee / progress updates for the others
ADTEST09_USERNAME="ADTest\Adtest09"
ADTEST09_PASSWORD="$EMPLOYEE_PASSWORD"
# Adtest10: default evaluator for Mastercard (BFS) and IT Support; committee / progress updates for the others
ADTEST10_USERNAME="ADTest\Adtest10"
ADTEST10_PASSWORD="$EMPLOYEE_PASSWORD"
# Adtest08: default evaluator for HR; committee / progress updates for the others
ADTEST08_USERNAME="ADTest\Adtest08"
ADTEST08_PASSWORD="$EMPLOYEE_PASSWORD"
# Rajesh and Satyam Sharma: committee members and progress updaters on every route. Login IDs not known yet - fill them in.
RAJESH_USERNAME=""
RAJESH_PASSWORD="$EMPLOYEE_PASSWORD"
SATYAM_SHARMA_USERNAME=""
SATYAM_SHARMA_PASSWORD="$EMPLOYEE_PASSWORD"
